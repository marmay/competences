executable competences-frontend
    import:           warnings
    default-extensions:
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedLabels,
        OverloadedRecordDot,
        OverloadedStrings
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        binary,
        bytestring,
        competences-common,
        competences-frontend,
        miso >= 1.9.0,
        random,
        text,
        uuid-types
    if !flag(wasm)
        build-depends:
            optparse-applicative
    if flag(wasm)
        build-depends:
            optics-core
        cpp-options: -DWASM
        ghc-options:
          -no-hs-main
          -optl-mexec-model=reactor
          "-optl-Wl,--export=hs_start"
    hs-source-dirs:   app
    default-language: GHC2024
