cabal-version:      3.4
name:               competences-common
version:            0.7.2.0
license:            BSD-3-Clause
author:             Markus Mayr
maintainer:         markus.mayr@tuta.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -Werror

library
    import:           warnings
    default-extensions:
        AllowAmbiguousTypes,
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedLabels,
        OverloadedRecordDot,
        OverloadedStrings
    exposed-modules:
        Competences.Analysis.Statistics
        Competences.Command
        Competences.Command.Assignments
        Competences.Command.ChangeField
        Competences.Command.Common
        Competences.Command.CompetenceAssessments
        Competences.Command.CompetenceGridGrades
        Competences.Command.Competences
        Competences.Command.Evidences
        Competences.Command.Interpret
        Competences.Command.Lessons
        Competences.Command.MesoPlans
        Competences.Command.ParticipationRecords
        Competences.Command.Resources
        Competences.Command.Solutions
        Competences.Command.Tasks
        Competences.Command.Users
        Competences.Common.BinaryOrphans
        Competences.Common.IxSet
        Competences.Document
        Competences.Document.ActivityType
        Competences.Document.Assessment
        Competences.Document.Assignment
        Competences.Document.Competence
        Competences.Document.CompetenceGrid
        Competences.Document.CompetenceGridGrade
        Competences.Document.Evidence
        Competences.Document.Grade
        Competences.Document.Id
        Competences.Document.Lesson
        Competences.Document.Lock
        Competences.Document.MesoPlan
        Competences.Document.Order
        Competences.Document.ParticipationRecord
        Competences.Document.Resource
        Competences.Document.Solution
        Competences.Document.Task
        Competences.Document.User
        Competences.Import.AssignmentParser
        Competences.Import.CompetenceGridParser
        Competences.Import.Export
        Competences.Import.Matching
        Competences.Import.TaskParser
        Competences.Import.Types
        Competences.Protocol
        Competences.Query.Assignment
        Competences.Query.Competence
        Competences.Query.CompetenceAssessment
        Competences.Query.CompetenceGrid
        Competences.Query.CompetenceGridGrade
        Competences.Query.Evidence
        Competences.Query.Lesson
        Competences.Query.Mastery
        Competences.Query.Resource
        Competences.Query.Solution
        Competences.Query.Task
        Competences.Query.User
        Competences.TaskContent.AST
        Competences.TaskContent.Parser
        Competences.TaskContent.RichContent
    build-depends:
        base ^>=4.21.0.0,
        aeson,
        attoparsec,
        base64-bytestring,
        binary,
        bytestring,
        containers,
        data-default,
        extra,
        ixset-typed,
        optics-core,
        random,
        text,
        time,
        uuid-types
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite competences-common-test
    import:           warnings
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.21.0.0,
        competences-common,
        containers,
        ixset-typed,
        time,
        text
