cabal-version:      3.4
name:               competences-common
version:            1.5.4.0
license:            BSD-3-Clause
author:             Markus Mayr
maintainer:         markus.mayr@tuta.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag aeson
    description: Enable Aeson JSON serialization instances
    default:     True

common warnings
    ghc-options: -Wall -Werror

library
    import:           warnings
    default-extensions:
        AllowAmbiguousTypes,
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedLabels,
        OverloadedRecordDot,
        OverloadedStrings
    exposed-modules:
        Competences.Analysis.Statistics
        Competences.Command
        Competences.Command.Absences
        Competences.Command.Assignments
        Competences.Command.Audience
        Competences.Command.ChangeField
        Competences.Command.Common
        Competences.Command.CompetenceAssessments
        Competences.Command.CompetenceGridGrades
        Competences.Command.CompetenceLevelExamples
        Competences.Command.Competences
        Competences.Command.DraftAssignments
        Competences.Command.DraftTasks
        Competences.Command.Evidences
        Competences.Command.Interpret
        Competences.Command.Layouts
        Competences.Command.Lessons
        Competences.Command.TeachingNotes
        Competences.Command.MesoPlans
        Competences.Command.ParticipationRecords
        Competences.Command.Publish
        Competences.Command.Resources
        Competences.Command.Solutions
        Competences.Command.Submissions
        Competences.Command.Tasks
        Competences.Command.Users
        Competences.Common.BinaryOrphans
        Competences.Common.IxSet
        Competences.Common.Set
        Competences.Document
        Competences.Document.Absence
        Competences.Document.ActivityType
        Competences.Document.Assessment
        Competences.Document.Assignment
        Competences.Document.Competence
        Competences.Document.CompetenceGrid
        Competences.Document.CompetenceGridGrade
        Competences.Document.CompetenceLevelExample
        Competences.Document.Evidence
        Competences.Document.FileRef
        Competences.Document.Grade
        Competences.Document.Id
        Competences.Document.Layout
        Competences.Document.Layout.Settings
        Competences.Document.Lesson
        Competences.Document.TeachingNote
        Competences.Document.Lock
        Competences.Document.MesoPlan
        Competences.Document.Session
        Competences.Document.Order
        Competences.Document.ParticipationRecord
        Competences.Document.Resource
        Competences.Document.Solution
        Competences.Document.Submission
        Competences.Document.Task
        Competences.Document.User
        Competences.Exchange.Build
        Competences.Exchange.Match
        Competences.Exchange.Types
        Competences.Protocol
        Competences.Query.Assignment
        Competences.Query.DefaultSelection
        Competences.Query.Competence
        Competences.Query.CompetenceAssessment
        Competences.Query.CompetenceGrid
        Competences.Query.CompetenceGridGrade
        Competences.Query.Evidence
        Competences.Query.Lesson
        Competences.Query.Mastery
        Competences.Query.Resource
        Competences.Query.Solution
        Competences.Query.Task
        Competences.Query.TaskStatus
        Competences.Query.User
        Competences.Search
        Competences.TaskContent.RichContent
    build-depends:
        base ^>=4.21.0.0,
        base64-bytestring,
        binary,
        bytestring,
        competences-markdown,
        containers,
        data-default,
        extra,
        ixset-typed,
        optics-core,
        random,
        text,
        time,
        uuid-types
    if flag(aeson)
        build-depends: aeson
        cpp-options: -DWITH_AESON
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite competences-common-test
    import:           warnings
    default-language: GHC2024
    default-extensions:
        DuplicateRecordFields,
        NoFieldSelectors,
        OverloadedRecordDot,
        OverloadedStrings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        Test.Generators
        Test.Query.MasteryTest
        Test.SearchTest
    build-depends:
        base ^>=4.21.0.0,
        competences-common,
        containers,
        ixset-typed,
        QuickCheck,
        random,
        tasty,
        tasty-hunit,
        tasty-quickcheck,
        text,
        time
