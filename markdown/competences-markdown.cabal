cabal-version:      3.4
name:               competences-markdown
version:            1.6.2.0
license:            BSD-3-Clause
author:             Markus Mayr
maintainer:         markus.mayr@tuta.com
category:           Text
build-type:         Simple

common warnings
    ghc-options: -Wall -Werror

library
    import:           warnings
    default-extensions:
        OverloadedStrings
    exposed-modules:
        Competences.Markdown.AST
        Competences.Markdown.Error
        Competences.Markdown.Parser
        Competences.Markdown.Parser.Block
        Competences.Markdown.Parser.Inline
        Competences.Markdown.Geometry.AST
        Competences.Markdown.Geometry.Eval
        Competences.Markdown.Geometry.Palette
        Competences.Markdown.Geometry.Parser
        Competences.Markdown.Validation
    build-depends:
        base >=4.21 && <4.23,
        containers,
        megaparsec,
        mtl,
        parser-combinators,
        text
    hs-source-dirs:   lib
    default-language: GHC2024

test-suite competences-markdown-test
    import:           warnings
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        Test.Markdown.ParserTest
        Test.Markdown.GeometryTest
        Test.Markdown.ValidationTest
    build-depends:
        base >=4.21 && <4.23,
        competences-markdown,
        containers,
        tasty,
        tasty-hunit,
        text
