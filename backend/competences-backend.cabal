cabal-version:      3.4
name:               competences-backend
version:            1.6.7.0
license:            BSD-3-Clause
author:             Markus Mayr
maintainer:         markus.mayr@tuta.com
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall -Werror

library
    import:           warnings
    default-extensions:
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedRecordDot,
        OverloadedStrings,
        TypeFamilies
    exposed-modules:
        Competences.Auth.Assertion
        Competences.Auth.HTTP
        Competences.Auth.Microsoft
        Competences.Auth.OAuth2Config
        Competences.Auth.SecurityConfig
        Competences.Backend.Auth
        Competences.Backend.BuildInfo
        Competences.Backend.CAS
        Competences.Backend.Checkpoint
        Competences.Backend.CommandProcessor
        Competences.Backend.Database
        Competences.Backend.Envelope
        Competences.Backend.Exchange
        Competences.Backend.HashedFile
        Competences.Backend.HTTP
        Competences.Backend.SecurityConfig
        Competences.Backend.SessionRegistry
        Competences.Backend.Shell
        Competences.Backend.StaleLockCleanup
        Competences.Backend.State
        Competences.Backend.WebSocket
    other-modules:
        Paths_competences_backend
        Competences.Internal.SecurityConfig
    build-depends:
        mtl ^>=2.3.1,
        base >=4.21 && <4.23,
        aeson,
        binary,
        blaze-html,
        bytestring,
        competences-common,
        containers,
        cookie,
        crypton,
        directory,
        filepath,
        fsnotify,
        http-client,
        http-client-tls,
        http-types,
        http-conduit,
        hslogger,
        jose >= 0.13,
        ixset-typed,
        lens,
        monad-time,
        mtl,
        network-uri,
        optics-core,
        optparse-applicative,
        postgresql-simple >= 0.7.0.1,
        process,
        ram,
        random,
        resource-pool,
        servant,
        servant-blaze,
        servant-server,
        tagged,
        servant-websockets,
        stm,
        text,
        time,
        unix,
        uuid,
        uuid-types,
        wai,
        wai-extra,
        wai-websockets,
        warp,
        websockets,
        yaml
    autogen-modules:  Paths_competences_backend
    hs-source-dirs:   lib
    default-language: GHC2024

executable competences-auth
    import:           warnings
    default-extensions:
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedRecordDot,
        OverloadedStrings,
        TypeFamilies
    ghc-options:      -threaded -rtsopts
    main-is:          Main.hs
    build-depends:
        base >=4.21 && <4.23,
        competences-backend,
        containers,
        http-client,
        http-client-tls,
        optparse-applicative,
        servant,
        servant-server,
        wai,
        warp
    hs-source-dirs:   app-auth
    default-language: GHC2024
           
executable competences-backend
    import:           warnings
    default-extensions:
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedRecordDot,
        OverloadedStrings,
        TypeFamilies
    ghc-options:      -threaded -rtsopts
    main-is:          Main.hs
    build-depends:
        base >=4.21 && <4.23,
        bytestring,
        competences-backend,
        competences-common,
        containers,
        optparse-applicative,
        postgresql-simple,
        resource-pool,
        servant,
        servant-server,
        stm,
        text,
        time,
        uuid,
        uuid-types,
        wai,
        wai-websockets,
        warp,
        websockets
    hs-source-dirs:   app-backend
    default-language: GHC2024

test-suite competences-backend-test
    import:           warnings
    default-extensions:
        DuplicateRecordFields,
        GADTs,
        NoFieldSelectors,
        OverloadedRecordDot,
        OverloadedStrings,
        TypeFamilies
    default-language: GHC2024
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base >=4.21 && <4.23,
        competences-backend
